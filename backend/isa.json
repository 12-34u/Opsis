    },
    "INT": {
      "description": "Software interrupt",
      "operand_count": 1,
      "variants": [
        {"mode": "imm", "opcode": "0xCD", "byte_width": 2, "imm_width": 1}
      ]
    },
    "NOP": {
      "description": "No operation",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0x90", "byte_width": 1}
      ]
    },
    "HLT": {
      "description": "Halt",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0xF4", "byte_width": 1}
      ]
    },
    "CLI": {
      "description": "Clear interrupt flag",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0xFA", "byte_width": 1}
      ]
    },
    "STI": {
      "description": "Set interrupt flag",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0xFB", "byte_width": 1}
      ]
    },
    "CLC": {
      "description": "Clear carry flag",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0xF8", "byte_width": 1}
      ]
    },
    "STC": {
      "description": "Set carry flag",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0xF9", "byte_width": 1}
      ]
    },
    "PUSHF": {
      "description": "Push flags",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0x9C", "byte_width": 1}
      ]
    },
    "POPF": {
      "description": "Pop flags",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0x9D", "byte_width": 1}
      ]
    },
    "XCHG": {
      "description": "Exchange",
      "operand_count": 2,
      "variants": [
        {"mode": "reg,reg", "opcode": "0x87", "modrm": true, "byte_width": 2}
      ]
    },
    "CBW": {
      "description": "Convert byte to word",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0x98", "byte_width": 1}
      ]
    },
    "CWD": {
      "description": "Convert word to dword",
      "operand_count": 0,
      "variants": [
        {"mode": "none", "opcode": "0x99", "byte_width": 1}
      ]
    },
    "OUT": {
      "description": "Output to port",
      "operand_count": 2,
      "variants": [
        {"mode": "imm,reg", "opcode": "0xE7", "byte_width": 2, "imm_width": 1}
